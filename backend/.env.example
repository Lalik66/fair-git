# =============================================================================
# Backend environment template — copy to backend/.env and fill in real values.
# =============================================================================

# --- Server ------------------------------------------------------------------
# Port the Express server listens on. Must match the port the frontend's
# VITE_API_URL / Vite proxy targets (default: 3002).
PORT=3002

# Node environment. Set to "production" in production deployments.
NODE_ENV=development

# Public URL of the frontend app. Used for CORS origin and OAuth redirects.
FRONTEND_URL=http://localhost:3000

# --- Database ----------------------------------------------------------------
# Prisma datasource URL. The default provider is SQLite (see prisma/schema.prisma).
# SQLite example:
DATABASE_URL="file:./dev.db"
# PostgreSQL example (if you switch the provider):
# DATABASE_URL="postgresql://user:password@localhost:5432/fair_marketplace?schema=public"

# --- Auth / sessions ---------------------------------------------------------
# Secret used to sign JWT access tokens. MUST be set in production — the code
# falls back to a weak default in development only.
JWT_SECRET=replace-with-a-long-random-string

# Secret used by express-session (required for Google OAuth state handling).
SESSION_SECRET=replace-with-another-long-random-string

# --- First admin bootstrap ---------------------------------------------------
# On first boot, the server seeds an admin account if it doesn't exist.
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=change-me-on-first-login
FIRST_ADMIN_FIRSTNAME=Admin
FIRST_ADMIN_LASTNAME=User

# --- Google OAuth ------------------------------------------------------------
# Create credentials at https://console.cloud.google.com/apis/credentials
# The callback URL below MUST be added to "Authorized redirect URIs" in the
# Google Cloud Console for the OAuth flow to work.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3002/api/auth/google/callback

# --- Gemini (AI chatbot) -----------------------------------------------------
# Used by POST /api/ai/chat. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Cloudinary (image uploads) ----------------------------------------------
# All three values come from your Cloudinary dashboard.
# If CLOUDINARY_CLOUD_NAME is empty, image upload features are disabled.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
