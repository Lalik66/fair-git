// Prisma schema for Fair Marketplace
// Uses SQLite for development

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Users table
model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  googleId            String?   @unique @map("google_id")
  firstName           String?   @map("first_name")
  lastName            String?   @map("last_name")
  phone               String?
  role                String    @default("user") // admin, vendor, user
  preferredLanguage   String    @default("az") @map("preferred_language") // az, en
  passwordHash        String?   @map("password_hash")
  mustChangePassword  Boolean   @default(false) @map("must_change_password")
  lastLogin           DateTime? @map("last_login")
  isActive            Boolean   @default(true) @map("is_active")
  lastLatitude        Float?    @map("last_latitude")
  lastLongitude       Float?    @map("last_longitude")
  locationUpdatedAt   DateTime? @map("location_updated_at")
  // Live-location sharing flag. Default true to preserve the original
  // implicit-share behavior — a festival app is a "find each other" tool,
  // so opt-out beats opt-in for the common case. Users who want privacy
  // can disable it any time from the Friends panel toggle.
  isSharingLocation   Boolean   @default(true) @map("is_sharing_location")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  // Relations
  vendorProfile       VendorProfile?
  adminLogs           AdminLog[]
  reviewedApplications Application[] @relation("ReviewedBy")
  aboutUsUpdates      AboutUsContent[]
  following           UserFollow[] @relation("UserFollowing")
  followers           UserFollow[] @relation("UserFollowers")
  inviteLinks         InviteLink[]
  conversationsAsParticipant1 Conversation[] @relation("ConversationParticipant1")
  conversationsAsParticipant2 Conversation[] @relation("ConversationParticipant2")
  sentMessages        Message[] @relation("MessageSender")
  reactionsSent       Reaction[] @relation("ReactionSender")
  reactionsReceived   Reaction[] @relation("ReactionRecipient")
  pins                UserPin[]
  reviewsWritten      Review[]  @relation("ReviewVisitor")
  reviewsModerated    Review[]  @relation("ReviewModerator")

  @@map("users")
}

// Personal map bookmarks (e.g. "I parked my car here"). Private to the user;
// never exposed to other accounts. Stored backend-side so the pin survives
// device changes and clearing localStorage. Unique on (userId, label) so
// "Save my car" overwrites the previous car location instead of stacking.
model UserPin {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  label     String   // "car" today; future: "picnic", "stroller", ...
  latitude  Float
  longitude Float
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, label])
  @@map("user_pins")
  @@index([userId])
}

// Sponsor / advertisement banners. Admin-managed; rendered in fixed
// placement slots (home hero, map top, popup footer, sidebar). The fairId
// is nullable so a sponsor can be either fair-specific or global.
model SponsorBanner {
  id          String   @id @default(uuid())
  fairId      String?  @map("fair_id")
  imageUrl    String   @map("image_url")
  linkUrl     String?  @map("link_url")
  // Free-form alt text + visible label. Both i18n'd because some sponsors
  // want a Latin-script name and others want Cyrillic/Azerbaijani.
  altText     String?  @map("alt_text")
  placement   String   // "home_hero" | "map_top" | "popup_footer" | "sidebar"
  startsAt    DateTime @map("starts_at")
  endsAt      DateTime @map("ends_at")
  priority    Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  impressions BannerImpression[]

  @@map("sponsor_banners")
  @@index([placement, isActive, startsAt, endsAt])
  @@index([fairId])
}

// One row per impression OR click — separated by eventType so we can compute
// CTR without a second table. userId is nullable to cover anonymous traffic.
model BannerImpression {
  id        String   @id @default(uuid())
  bannerId  String   @map("banner_id")
  eventType String   @map("event_type") // "impression" | "click"
  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  banner    SponsorBanner @relation(fields: [bannerId], references: [id], onDelete: Cascade)

  @@map("banner_impressions")
  @@index([bannerId, createdAt])
  @@index([eventType, createdAt])
}

// Vendor profiles table
model VendorProfile {
  id                  String    @id @default(uuid())
  userId              String    @unique @map("user_id")
  companyName         String?   @map("company_name")
  businessDescription String?   @map("business_description")
  logoUrl             String?   @map("logo_url")
  productCategory     String?   @map("product_category") // food_beverages, handicrafts, clothing, accessories, other
  // Cached review aggregates — recomputed by reviewService.recalcVendorRating
  // whenever a review is approved or un-approved. Avoids a reviews scan on
  // every public map/profile read.
  avgRating           Float     @default(0) @map("avg_rating")
  reviewCount         Int       @default(0) @map("review_count")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  // Relations
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  productImages       VendorProductImage[]
  applications        Application[]
  bookings            Booking[]
  reviews             Review[]

  @@map("vendor_profiles")
}

// Vendor product images table
model VendorProductImage {
  id              String        @id @default(uuid())
  vendorProfileId String        @map("vendor_profile_id")
  imageUrl        String        @map("image_url")
  orderIndex      Int           @default(0) @map("order_index")
  createdAt       DateTime      @default(now()) @map("created_at")

  // Relations
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)

  @@map("vendor_product_images")
}

// Fairs table
model Fair {
  id              String    @id @default(uuid())
  name            String
  descriptionAz   String?   @map("description_az")
  descriptionEn   String?   @map("description_en")
  startDate       DateTime  @map("start_date")
  endDate         DateTime  @map("end_date")
  locationAddress String?   @map("location_address")
  mapCenterLat    Float?    @map("map_center_lat")
  mapCenterLng    Float?    @map("map_center_lng")
  bannerImageUrl  String?   @map("banner_image_url")
  // Archive media. galleryUrls is a JSON-stringified String array of image URLs
  // (SQLite has no native JSON type; parsed on read); archiveVideoUrl is one optional video URL.
  galleryUrls     String?   @map("gallery_urls")
  archiveVideoUrl String?   @map("archive_video_url")
  status          String    @default("upcoming") // upcoming, active, completed, archived
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  archivedAt      DateTime? @map("archived_at")

  // Relations
  applications    Application[]
  bookings        Booking[]
  zones           MapZone[]
  events          FairEvent[]

  @@map("fairs")
  @@index([status])
  @@index([status, startDate])
}

// Tappable, colored regions on the fair map ("food court", "kids zone", "VIP").
// Scoped to a fair so different fairs in different venues each get their own
// layout. Geometry is stored as a JSON-stringified GeoJSON Polygon because
// SQLite has no native JSON type; we parse on read.
model MapZone {
  id            String   @id @default(uuid())
  fairId        String   @map("fair_id")
  name          String
  type          String   // food | kids | vip | craft | stage | info | other
  color         String   // hex, e.g. "#F59E0B"
  opacity       Float    @default(0.30)
  descriptionAz String?  @map("description_az")
  descriptionEn String?  @map("description_en")
  // Stringified GeoJSON Polygon: { type: "Polygon", coordinates: [[[lng,lat], ...]] }
  geometry      String
  isVisible     Boolean  @default(true) @map("is_visible")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  fair          Fair     @relation(fields: [fairId], references: [id], onDelete: Cascade)

  @@map("map_zones")
  @@index([fairId, isVisible])
}

// Scheduled activity tied to a fair and a single map location. Powers the
// per-location program list in popups, the standalone Schedule page, and the
// "What's On Now" filter. Location is polymorphic because an event can sit on
// a vendor house, a facility, or a zone — we want one table, not three.
model FairEvent {
  id            String   @id @default(uuid())
  fairId        String   @map("fair_id")
  nameAz        String   @map("name_az")
  nameEn        String   @map("name_en")
  descriptionAz String?  @map("description_az")
  descriptionEn String?  @map("description_en")
  category      String   // performance | workshop | food | show | music | other
  emoji         String?  // optional glyph for "What's On Now" rows
  startTime     DateTime @map("start_time")
  endTime       DateTime @map("end_time")
  // Polymorphic location reference. locationType narrows which table
  // locationId points at; we resolve coordinates server-side per request.
  locationType  String   @map("location_type") // "house" | "facility" | "zone"
  locationId    String   @map("location_id")
  isCancelled   Boolean  @default(false) @map("is_cancelled")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  fair          Fair     @relation(fields: [fairId], references: [id], onDelete: Cascade)

  @@map("fair_events")
  @@index([fairId, startTime])
  @@index([fairId, endTime])
  @@index([locationType, locationId])
}

// Vendor houses table
model VendorHouse {
  id              String    @id @default(uuid())
  houseNumber     String    @unique @map("house_number")
  areaSqm         Float?    @map("area_sqm")
  price           Float?
  // Operational/internal note. Only exposed to vendor/admin (privileged) API
  // responses, never to regular visitors on the public map.
  description     String?
  // Public, visitor-facing blurb: what this place is about (what they sell,
  // food vs crafts, the vibe). Shown to everyone on the map regardless of role.
  // Admin-editable (houses are a shared pool, not vendor-owned).
  visitorStory    String?   @map("visitor_story")
  latitude        Float
  longitude       Float
  panorama360Url  String?   @map("panorama_360_url")
  isEnabled       Boolean   @default(true) @map("is_enabled")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  applications    Application[]
  bookings        Booking[]
  clicks          VendorClick[]

  @@map("vendor_houses")
  @@index([isEnabled])
}

// Visitor analytics: one row per popup-open or directions-tap on a vendor
// house marker. userId is nullable so anonymous foot traffic is captured too.
model VendorClick {
  id            String      @id @default(uuid())
  vendorHouseId String      @map("vendor_house_id")
  userId        String?     @map("user_id")
  eventType     String      @map("event_type") // "popup_open" | "directions"
  createdAt     DateTime    @default(now()) @map("created_at")

  vendorHouse   VendorHouse @relation(fields: [vendorHouseId], references: [id], onDelete: Cascade)

  @@map("vendor_clicks")
  @@index([vendorHouseId, createdAt])
  @@index([createdAt])
  @@index([eventType, createdAt])
}

// Facilities table
model Facility {
  id          String   @id @default(uuid())
  name        String
  type        String   // restaurant, cafe, kids_zone, restroom, taxi, bus_stop, parking
  description String?
  latitude    Float
  longitude   Float
  photoUrl    String?  @map("photo_url")
  icon        String?
  color       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("facilities")
  @@index([type])
}

// Applications table
model Application {
  id              String    @id @default(uuid())
  vendorProfileId String    @map("vendor_profile_id")
  fairId          String    @map("fair_id")
  vendorHouseId   String    @map("vendor_house_id")
  status          String    @default("pending") // pending, approved, rejected
  adminNotes      String?   @map("admin_notes")
  rejectionReason String?   @map("rejection_reason")
  submittedAt     DateTime  @default(now()) @map("submitted_at")
  reviewedAt      DateTime? @map("reviewed_at")
  reviewedById    String?   @map("reviewed_by")
  // Applicant personal data collected by the public vendor application form.
  // Nullable so the pre-existing applications (created by the old map-only
  // flow, which never collected these) keep displaying without a backfill.
  firstName       String?   @map("first_name")
  lastName        String?   @map("last_name")
  patronymic      String?
  applicantEmail  String?   @map("applicant_email")
  applicantPhone  String?   @map("applicant_phone")
  idSeries        String?   @map("id_series")
  idNumber        String?   @map("id_number")
  financialId     String?   @map("financial_id")
  dateOfBirth     DateTime? @map("date_of_birth")
  country         String?
  city            String?
  rulesAccepted   Boolean   @default(false) @map("rules_accepted")
  paymentAccepted Boolean   @default(false) @map("payment_accepted")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  fair            Fair          @relation(fields: [fairId], references: [id], onDelete: Cascade)
  vendorHouse     VendorHouse   @relation(fields: [vendorHouseId], references: [id], onDelete: Cascade)
  reviewedBy      User?         @relation("ReviewedBy", fields: [reviewedById], references: [id])
  booking         Booking?

  @@map("applications")
}

// Bookings table
model Booking {
  id              String   @id @default(uuid())
  applicationId   String   @unique @map("application_id")
  vendorProfileId String   @map("vendor_profile_id")
  vendorHouseId   String   @map("vendor_house_id")
  fairId          String   @map("fair_id")
  bookingStatus   String   @default("pending") @map("booking_status") // pending, approved, completed, archived
  startDate       DateTime @map("start_date")
  endDate         DateTime @map("end_date")
  isArchived      Boolean  @default(false) @map("is_archived")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  application     Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  vendorHouse     VendorHouse   @relation(fields: [vendorHouseId], references: [id], onDelete: Cascade)
  fair            Fair          @relation(fields: [fairId], references: [id], onDelete: Cascade)

  @@map("bookings")
  @@index([fairId, bookingStatus, isArchived])
  @@index([vendorHouseId])
}

// Admin activity logs table
model AdminLog {
  id        String   @id @default(uuid())
  adminId   String   @map("admin_id")
  action    String
  details   String?
  ipAddress String?  @map("ip_address")
  timestamp DateTime @default(now())

  // Relations
  admin     User     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("admin_logs")
}

// About Us content table
model AboutUsContent {
  id          String   @id @default(uuid())
  sectionKey  String   @unique @map("section_key")
  contentAz   String?  @map("content_az")
  contentEn   String?  @map("content_en")
  updatedById String?  @map("updated_by")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  updatedBy   User?    @relation(fields: [updatedById], references: [id])

  @@map("about_us_content")
}

// Site contact info (phone, email, social links) - editable in Admin, single row
model SiteContactInfo {
  id           String   @id @default(uuid())
  phone        String?
  email        String?
  facebookUrl  String?  @map("facebook_url")
  instagramUrl String?  @map("instagram_url")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("site_contact_info")
}

// User follow relationships (asymmetric - like Twitter/Instagram)
model UserFollow {
  id          String   @id @default(uuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("user_follows")
  @@index([followerId])
  @@index([followingId])
}

// Conversation between two mutual friends (1:1 messaging)
// Uses normalized participant order: participant1 < participant2 (lexicographically)
model Conversation {
  id           String    @id @default(uuid())
  participant1 String    @map("participant_1")
  participant2 String    @map("participant_2")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  user1        User      @relation("ConversationParticipant1", fields: [participant1], references: [id], onDelete: Cascade)
  user2        User      @relation("ConversationParticipant2", fields: [participant2], references: [id], onDelete: Cascade)
  messages     Message[]

  @@unique([participant1, participant2])
  @@index([participant1])
  @@index([participant2])
  @@index([updatedAt])
  @@map("conversations")
}

// Chat message in a conversation
model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  senderId       String       @map("sender_id")
  content        String
  createdAt      DateTime     @default(now()) @map("created_at")
  readAt         DateTime?    @map("read_at")
  isDeleted      Boolean      @default(false) @map("is_deleted")

  // Relations
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([conversationId, senderId, readAt])
  @@index([senderId])
  @@map("messages")
}

// Invite links for friend invitations
model InviteLink {
  id          String   @id @default(uuid())
  token       String   @unique
  createdById String   @map("created_by_id")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@map("invite_links")
  @@index([token])
  @@index([createdById])
}

// Reaction (2GIS-style quick emoji reactions between friends)
model Reaction {
  id          String    @id @default(uuid())
  senderId    String    @map("sender_id")
  recipientId String    @map("recipient_id")
  emoji       String
  createdAt   DateTime  @default(now()) @map("created_at")
  // Null = unread by the recipient. Set when the recipient acknowledges via
  // PATCH /api/friends/reactions/mark-seen. Soft-delete preserves history
  // for analytics / audit / multi-device sync (replaces the old hard delete).
  seenAt      DateTime? @map("seen_at")

  // Relations
  sender    User @relation("ReactionSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("ReactionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt(sort: Desc)])
  @@index([recipientId, seenAt])
  @@index([senderId])
  @@map("reactions")
}

// Vendor reviews left by visitors. Moderated: nothing is public until an
// admin approves it. SQLite has no enums/JSON, so `status` is a plain string
// (PENDING | APPROVED | REJECTED) and `categories` is a JSON-encoded string
// {"quality":1-5,"service":1-5,"priceValue":1-5}. Aggregates live on
// VendorProfile (avgRating / reviewCount) and count APPROVED reviews only.
model Review {
  id              String    @id @default(uuid())
  vendorId        String    @map("vendor_id")
  visitorId       String    @map("visitor_id")

  rating          Int       // 1-5 overall stars
  categories      String?   // JSON: {"quality":5,"service":4,"priceValue":3}
  comment         String?

  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED
  rejectionReason String?   @map("rejection_reason")

  vendorReply     String?   @map("vendor_reply")
  repliedAt       DateTime? @map("replied_at")

  // Visitor "report suspicious review" counter. Reviews with reports float to
  // the top of the admin queue for a second look.
  reportCount     Int       @default(0) @map("report_count")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  moderatedAt     DateTime? @map("moderated_at")
  moderatedById   String?   @map("moderated_by_id")

  // Relations
  vendor          VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  visitor         User          @relation("ReviewVisitor", fields: [visitorId], references: [id], onDelete: Cascade)
  moderatedBy     User?         @relation("ReviewModerator", fields: [moderatedById], references: [id], onDelete: SetNull)

  // One review per visitor per vendor. Editing replaces the old one and
  // resets it to PENDING.
  @@unique([vendorId, visitorId])
  @@index([vendorId, status])
  @@index([status, createdAt])
  @@map("reviews")
}
