# =============================================================================
# Frontend environment template — copy to frontend/.env and fill in real values.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# =============================================================================

# Base URL for backend REST calls. Must include the trailing /api.
# In dev, this should match the backend PORT in backend/.env.
VITE_API_URL=http://localhost:3002/api

# Base URL for the Socket.io WebSocket connection (friends messages, etc.).
# If unset, the client derives it by stripping /api off VITE_API_URL.
VITE_WS_URL=http://localhost:3002

# Mapbox public access token — used by the map page and route-to-friend feature.
# Create one at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=

# =============================================================================
# Production (Vercel) values — set these in the Vercel project's Environment
# Variables, NOT here. Backend is live on Railway.
#   VITE_API_URL   = https://fair-git-production.up.railway.app/api
#   VITE_WS_URL    = https://fair-git-production.up.railway.app
#   VITE_MAPBOX_TOKEN = <your Mapbox public token>
# After deploying, set FRONTEND_URL on Railway to the Vercel domain (CORS +
# cross-site cookie), and add the Vercel domain nowhere in Google OAuth — the
# OAuth callback stays the Railway backend URL.
# =============================================================================
